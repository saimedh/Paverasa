# Resend Email Configuration
# Sign up at https://resend.com and obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Destination email where inquiries and bookings will be received
RESEND_TO_EMAIL=support@paverasa.in

# From email (use 'onboarding@resend.dev' for testing, or your verified domain e.g. 'contact@paverasa.in')
RESEND_FROM_EMAIL=Paverasa <onboarding@resend.dev>
